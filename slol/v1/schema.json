{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oblivia.protocol/slol/v1/schema.json",
  "title": "Smart Legal Object Layer v1",
  "description": "Open standard for representing legal agreements as composable on-chain objects. Zero identity required. All parties identified by cryptographic commitments only.",
  "version": "1.0.0",
  "definitions": {
    "Party": {
      "type": "object",
      "description": "A signatory identified only by their ZK key commitment. No name. No identity.",
      "required": ["key_commitment", "signature_commitment"],
      "properties": {
        "key_commitment": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$",
          "description": "Pedersen hash of signer's biometric-derived key. Proves unique identity without revealing it."
        },
        "signature_commitment": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$",
          "description": "Pedersen hash binding signer key + contract hash + timestamp. Non-repudiable."
        },
        "timestamp": {
          "type": "integer",
          "description": "Unix timestamp of signing"
        },
        "on_chain_tx": {
          "type": "string",
          "description": "Solana transaction signature confirming on-chain submission"
        }
      }
    },
    "ContractBase": {
      "type": "object",
      "required": ["slol_version", "contract_type", "contract_hash", "created_at"],
      "properties": {
        "slol_version": { "type": "string", "const": "1.0.0" },
        "contract_type": {
          "type": "string",
          "enum": ["NDA", "ContributorAgreement", "GovernanceDecision", "WhistleblowerAgreement", "InheritanceDirective", "ZeroIDDeal"]
        },
        "contract_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 hash of full contract content"
        },
        "created_at": { "type": "integer" },
        "on_chain_program": {
          "type": "string",
          "description": "Solana program ID — HaRpXyybfpYpwxkhfj8CjY8EjGqvRd96Zi33iSCTxvHG"
        },
        "network": {
          "type": "string",
          "enum": ["mainnet-beta", "devnet", "testnet"]
        },
        "parties": {
          "type": "array",
          "items": { "$ref": "#/definitions/Party" },
          "minItems": 1
        },
        "multisig": {
          "type": "object",
          "properties": {
            "threshold": { "type": "integer", "minimum": 1 },
            "max_signers": { "type": "integer", "minimum": 1 },
            "finalized": { "type": "boolean" },
            "finalized_at": { "type": "integer" }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "title": "NDA",
      "description": "Non-disclosure agreement. Parties commit to confidentiality without revealing identity.",
      "allOf": [
        { "$ref": "#/definitions/ContractBase" },
        {
          "properties": {
            "contract_type": { "const": "NDA" },
            "terms": {
              "type": "object",
              "properties": {
                "confidentiality_period_days": { "type": "integer" },
                "scope": { "type": "string" },
                "jurisdiction": { "type": "string" }
              }
            }
          }
        }
      ]
    },
    {
      "title": "ContributorAgreement",
      "description": "DAO or open-source contributor agreement. Contributor retains pseudonymity.",
      "allOf": [
        { "$ref": "#/definitions/ContractBase" },
        {
          "properties": {
            "contract_type": { "const": "ContributorAgreement" },
            "terms": {
              "type": "object",
              "properties": {
                "project": { "type": "string" },
                "ip_assignment": { "type": "boolean" },
                "compensation_type": { "type": "string", "enum": ["token", "fiat", "equity", "none"] }
              }
            }
          }
        }
      ]
    },
    {
      "title": "GovernanceDecision",
      "description": "DAO governance agreement. All voters anonymous. Threshold signatures enforce quorum.",
      "allOf": [
        { "$ref": "#/definitions/ContractBase" },
        {
          "properties": {
            "contract_type": { "const": "GovernanceDecision" },
            "terms": {
              "type": "object",
              "properties": {
                "proposal_hash": { "type": "string" },
                "quorum_threshold": { "type": "integer" },
                "vote_type": { "type": "string", "enum": ["simple_majority", "supermajority", "unanimous"] }
              }
            }
          }
        }
      ]
    },
    {
      "title": "WhistleblowerAgreement",
      "description": "Journalist-source agreement. Proves consent to disclosure without identity trail.",
      "allOf": [
        { "$ref": "#/definitions/ContractBase" },
        {
          "properties": {
            "contract_type": { "const": "WhistleblowerAgreement" },
            "terms": {
              "type": "object",
              "properties": {
                "disclosure_scope": { "type": "string" },
                "expiry_timestamp": { "type": "integer" },
                "revocable": { "type": "boolean" }
              }
            }
          }
        }
      ]
    },
    {
      "title": "InheritanceDirective",
      "description": "On-chain inheritance. Asset transfer conditions enforced programmatically. No lawyers required.",
      "allOf": [
        { "$ref": "#/definitions/ContractBase" },
        {
          "properties": {
            "contract_type": { "const": "InheritanceDirective" },
            "terms": {
              "type": "object",
              "properties": {
                "trigger_condition": { "type": "string", "enum": ["time_lock", "oracle_condition", "multisig_confirmation"] },
                "trigger_timestamp": { "type": "integer" },
                "asset_references": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      ]
    },
    {
      "title": "ZeroIDDeal",
      "description": "Fully anonymous multi-party deal. All signers pseudonymous. Non-repudiable by construction.",
      "allOf": [
        { "$ref": "#/definitions/ContractBase" },
        {
          "properties": {
            "contract_type": { "const": "ZeroIDDeal" },
            "terms": {
              "type": "object",
              "properties": {
                "deal_hash": { "type": "string" },
                "required_signers": { "type": "integer" },
                "expiry_timestamp": { "type": "integer" }
              }
            }
          }
        }
      ]
    }
  ]
}
