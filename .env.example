# Oblivia Protocol - Environment Variables
# Copy this file to .env and fill in your values

# Solana devnet keypair for proof anchoring (hex encoded secret key)
# Generate with: node -e "const {Keypair} = require('@solana/web3.js'); console.log(Buffer.from(Keypair.generate().secretKey).toString('hex'));"
OBLIVIA_DEVNET_KEY=your_hex_encoded_secret_key_here

# Required by the relay. Keep this secret and send it as an Authorization bearer token.
OBLIVIA_RELAY_API_KEY=replace_with_a_long_random_secret
# Comma-separated browser origins permitted to call the relay.
OBLIVIA_ALLOWED_ORIGINS=https://your-app.example
